// Vociant Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Projects & Organization
// ============================================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents          Agent[]
  knowledgeSources KnowledgeSource[]
  tools           Tool[]

  @@map("projects")
}

// ============================================================================
// Agents
// ============================================================================

model Agent {
  id          String  @id @default(cuid())
  projectId   String?
  name        String
  slug        String  @unique
  description String?
  status      String  @default("draft") // draft, active, archived

  // Personality & Behavior
  systemPrompt       String  @default("")
  style              String? // supportive, concise, detailed, professional, friendly
  maxTurnsPerSession Int?

  // v2: First Message & Dynamic Variables
  firstMessage      String? // What agent says when conversation starts
  dynamicVariables  String? // JSON array: ["user_name", "order_id", etc.]

  // Voice & Audio
  voiceProfileId String?
  ttsProvider    String  @default("mock") // elevenlabs, google, deepgram, openai, mock
  ttsModel       String?
  sttProvider    String  @default("mock") // elevenlabs, deepgram, google, openai-whisper, mock
  sttModel       String?

  // Voice settings (JSON)
  voiceSettings String? // JSON: { stability, similarityBoost, speed, pitch, energy }

  // v2: Language & Pronunciation
  language                String  @default("en-US") // Primary language
  supportedLanguages      String? // JSON array: ["en-US", "es-ES", "fr-FR"]
  pronunciationDictionary String? // JSON: { "API": "A P I", "SQLite": "S Q L ite" }

  // LLM Configuration
  llmProvider String @default("openai") // openai, anthropic, google, mock
  llmModel    String @default("gpt-4-turbo-preview")
  llmConfig   String? // JSON: { temperature, maxTokens, topP, etc. }

  // Conversation Flow
  silenceTimeoutMs       Int     @default(5000)
  interruptionsEnabled   Boolean @default(true)
  turnEagerness          String  @default("medium") // low, medium, high
  maxResponseLengthSec   Int?
  latencyTargetMs        Int?

  // v2: Turn Timeout (specific to prompting user after silence)
  turnTimeoutSeconds     Int     @default(10) // 1-30 seconds before prompting user

  // Knowledge & RAG
  ragEnabled  Boolean @default(false)
  ragConfig   String? // JSON: { topK, chunkSize, embeddingProvider, etc. }

  // Tools
  toolExecutionPolicy String @default("auto") // strict, auto, ask-before-call

  // Channels
  webWidgetEnabled Boolean @default(true)
  allowedOrigins   String? // JSON array

  // v3: Authentication & Security
  requireSignedUrls Boolean @default(false) // Require signed URLs for client access
  signedUrlSecret   String? // Secret for signing URLs (auto-generated)
  domainAllowlist   String? // JSON array: ["https://example.com", "*.mydomain.com"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])

  sessions            Session[]
  agentKnowledgeBases AgentKnowledgeBase[]
  agentTools          AgentTool[]

  @@map("agents")
}

// ============================================================================
// Knowledge Base
// ============================================================================

model KnowledgeSource {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  type        String // url, file, text, s3, github
  status      String   @default("pending") // pending, indexing, ready, failed
  config      String // JSON config based on type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  agentKnowledgeBases AgentKnowledgeBase[]
  chunks              KnowledgeChunk[]

  @@map("knowledge_sources")
}

model AgentKnowledgeBase {
  id                String @id @default(cuid())
  agentId           String
  knowledgeSourceId String

  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeSourceId])
  @@map("agent_knowledge_bases")
}

model KnowledgeChunk {
  id                String  @id @default(cuid())
  knowledgeSourceId String
  content           String
  embedding         String? // JSON array of floats
  metadata          String? // JSON metadata

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

// ============================================================================
// Tools
// ============================================================================

model Tool {
  id          String  @id @default(cuid())
  projectId   String?
  name        String
  description String
  category    String // system, server, client
  schema      String // JSON: OpenAI function schema
  endpoint    String? // For server tools

  // v3: Enhanced Authentication
  authType    String  @default("none") // none, api-key, bearer, oauth2-client-credentials, oauth2-jwt-bearer, basic
  authConfig  String? // JSON: non-secret config (token_url, etc.)
  secretId    String? // FK to Secret (for sensitive credentials)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project?    @relation(fields: [projectId], references: [id])
  secret     Secret?     @relation(fields: [secretId], references: [id])
  agentTools AgentTool[]

  @@map("tools")
}

model AgentTool {
  id      String @id @default(cuid())
  agentId String
  toolId  String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@map("agent_tools")
}

// ============================================================================
// Sessions & Transcripts
// ============================================================================

model Session {
  id          String   @id @default(cuid())
  agentId     String
  channelType String   @default("web") // web, telephony, sip
  status      String   @default("active") // active, completed, failed, timeout
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  metadata    String? // JSON

  // v2: Runtime Overrides (JSON)
  overrides   String? // JSON: { systemPrompt, firstMessage, language, voiceId, etc. }

  // v5: A/B Testing
  abTestId    String?
  variantId   String?

  agent       Agent                   @relation(fields: [agentId], references: [id])
  turns       Turn[]
  evaluation  ConversationEvaluation?
  abTest      ABTest?                 @relation(fields: [abTestId], references: [id])
  variant     ABTestVariant?          @relation(fields: [variantId], references: [id])

  @@map("sessions")
}

model Turn {
  id               String   @id @default(cuid())
  sessionId        String
  userMessage      String?
  assistantMessage String?
  toolCalls        String? // JSON array
  toolResults      String? // JSON array
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  // v4/v5: Enhanced Latency Tracking
  sttLatencyMs     Int?
  llmLatencyMs     Int?
  ttsLatencyMs     Int?
  totalLatencyMs   Int?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("turns")
}

// ============================================================================
// Provider Credentials (encrypted in production)
// ============================================================================

model ProviderCredential {
  id         String   @id @default(cuid())
  projectId  String? // null = global
  provider   String // elevenlabs, openai, anthropic, etc.
  label      String // User-friendly label
  apiKey     String // TODO: Encrypt in production
  config     String? // JSON: additional config
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, provider, label])
  @@map("provider_credentials")
}

// ============================================================================
// v3: Secrets Management
// ============================================================================

model Secret {
  id          String   @id @default(cuid())
  projectId   String?  // null = global
  name        String   // User-friendly name
  description String?
  type        String   @default("generic") // generic, oauth2, api-key, jwt

  // Encrypted value (format: iv.authTag.ciphertext)
  encryptedValue String

  // Metadata (non-sensitive config like token URLs, algorithm, etc.)
  metadata    String? // JSON

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?

  tools       Tool[]
  webhooks    Webhook[]

  @@map("secrets")
}

// ============================================================================
// v3: Webhooks
// ============================================================================

model Webhook {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  url         String
  events      String   // JSON array: ["session.completed", "agent.evaluated"]

  // HMAC authentication
  secretId    String?  // FK to Secret (shared secret for HMAC)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  secret      Secret?  @relation(fields: [secretId], references: [id])

  @@map("webhooks")
}

// ============================================================================
// v4/v5: Analytics & Evaluation
// ============================================================================

model ConversationEvaluation {
  id                String   @id @default(cuid())
  sessionId         String   @unique

  // Overall evaluation
  overallSuccess    Boolean?

  // Criteria-based evaluation
  successCriteria   String?  // JSON array of criteria strings
  evaluationResults String?  // JSON: { "criterion1": true, "criterion2": false }

  // Collected data during conversation
  collectedData     String?  // JSON: { "email": "...", "phone": "..." }

  // Metadata
  evaluatedAt       DateTime @default(now())
  evaluatedBy       String?  // "system", "human", or user ID
  notes             String?

  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("conversation_evaluations")
}

model AgentMetrics {
  id                String   @id @default(cuid())
  agentId           String
  date              DateTime // Date for daily aggregation

  // Volume metrics
  totalSessions     Int      @default(0)
  completedSessions Int      @default(0)
  failedSessions    Int      @default(0)

  // Duration metrics
  avgDurationMs     Int?
  minDurationMs     Int?
  maxDurationMs     Int?

  // Latency metrics
  avgTotalLatencyMs Int?
  avgLLMLatencyMs   Int?
  avgTTSLatencyMs   Int?
  avgSTTLatencyMs   Int?

  // Success metrics
  successRate       Float?   // 0.0 to 100.0
  evaluatedCount    Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([agentId, date])
  @@map("agent_metrics")
}

// ============================================================================
// v5: A/B Testing Framework
// ============================================================================

model ABTest {
  id          String   @id @default(cuid())
  agentId     String
  name        String
  description String?
  status      String   @default("draft") // draft, running, paused, completed

  // Traffic allocation
  trafficAllocation Float  @default(100.0) // Percentage of traffic to include in test

  // Test configuration
  startDate       DateTime?
  endDate         DateTime?
  minSampleSize   Int      @default(100) // Minimum sessions per variant

  // Success metric configuration
  successMetric   String   @default("evaluation") // evaluation, duration, completion_rate

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        ABTestVariant[]
  sessions        Session[]

  @@map("ab_tests")
}

model ABTestVariant {
  id            String   @id @default(cuid())
  abTestId      String
  name          String
  description   String?
  isControl     Boolean  @default(false)

  // Traffic split (must sum to 100 across all variants in a test)
  trafficWeight Int      @default(50) // 0-100

  // Configuration overrides (JSON)
  config        String?  // JSON: { systemPrompt, voiceId, llmModel, temperature, etc. }

  // Performance metrics (computed)
  totalSessions Int      @default(0)
  successCount  Int      @default(0)
  successRate   Float?
  avgLatencyMs  Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  abTest        ABTest   @relation(fields: [abTestId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@map("ab_test_variants")
}
