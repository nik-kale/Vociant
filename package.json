{
  "name": "vociant",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-agnostic voice agent control plane",
  "scripts": {
    "dev": "pnpm --filter vociant-console dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter vociant-console db:push",
    "db:studio": "pnpm --filter vociant-console db:studio",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  },
  "keywords": [
    "voice-ai",
    "conversational-ai",
    "voice-agents",
    "tts",
    "stt",
    "llm",
    "vendor-agnostic"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
